# ============================================================
# 环境变量模板（.env.example）
#
# 使用方法（可选，不是必须）：
#   cp .env.example .env   # Windows: copy .env.example .env
#   填好后由你的启动脚本 / docker / systemd 读入环境。
#
# 优先级：环境变量 > config.yaml > 内置默认值
# 即：只要设置了下面的变量，就会覆盖 config.yaml 里的同名字段。
# .env 已被 .gitignore 排除，不会被提交。
# ============================================================

# ---------- 服务器 ----------
# 监听地址与端口
#APP_HOST=0.0.0.0
#APP_PORT=8600
# CORS 白名单（逗号分隔，覆盖 config.yaml 的 server.cors_origins）
#CORS_ORIGINS=https://your-domain.com

# ---------- 安全密钥（一般留空，由 data/secret.key 自动生成） ----------
# 注意：手动设置后所有会话/加密数据都将依赖该值，请务必稳定保存
#JWT_SECRET=
#FERNET_KEY=

# ---------- LLM provider 配置 ----------
# 命名规则：LLM_<PROVIDER>_字段，<PROVIDER> 为 config.yaml 中
# providers 下的小写名（zhipu / deepseek / openai）转大写。
#
# 示例：注入 OpenAI 兼容 Key（覆盖 config.yaml 的 openai 配置）
#LLM_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
#LLM_OPENAI_BASE_URL=https://api.openai.com/v1
#LLM_OPENAI_CHAT_MODEL=gpt-4o-mini
#LLM_OPENAI_VISION_MODEL=gpt-4o
#LLM_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#
# 示例：注入智谱
#LLM_ZHIPU_API_KEY=xxxxxxxx.xxxxxxxx
#LLM_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#LLM_ZHIPU_CHAT_MODEL=glm-4-flash
#LLM_ZHIPU_VISION_MODEL=glm-4v-flash
#
# 示例：注入 DeepSeek
#LLM_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
#LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
#LLM_DEEPSEEK_CHAT_MODEL=deepseek-chat
#
# 也可以定义 config.yaml 中不存在的全新 provider：
#LLM_MYPROV_API_KEY=sk-xxxxxxxxxxxxxxxx
#LLM_MYPROV_BASE_URL=https://my-relay.example.com/v1
#LLM_MYPROV_CHAT_MODEL=some-model

# ---------- 默认 provider ----------
#LLM_DEFAULT_PROVIDER=openai

# ---------- RAG 混合检索增强（可选，均有默认值） ----------
# 本地向量模型（HuggingFace 名或本地路径）
#RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 是否启用 LLM 精排
#RAG_USE_RERANK=true
# 精排候选数（RRF 融合后取前 N 送入 LLM）
#RAG_RERANK_TOP_N=20
# RRF 平滑常数
#RAG_RRF_K=60
# 向量化批大小
#RAG_EMBED_BATCH=32

# ---------- Critic 反思机制 ----------
# 独立 critic provider 名（留空则缺省复用对话模型）
#CRITIC_PROVIDER=openai
# 达标阈值（0-10，>= 该值判定通过）
#CRITIC_PASS_SCORE=7
# 最大反思轮数（3-5）
#CRITIC_MAX_ROUNDS=3

# ---------- 分层摘要上下文机制 ----------
# 段落级摘要滚存粒度（每 N 轮滚存一段）
#MEMORY_PARAGRAPH_SIZE=5
# 是否启用历史关键词检索
#MEMORY_ENABLE_HISTORY=true
# 是否在上下文中注入摘要层
#MEMORY_USE_SUMMARY=true
